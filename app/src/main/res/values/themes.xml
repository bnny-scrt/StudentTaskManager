<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.StudentTaskManager" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorSecondaryContainer">@color/primary</item>
        <item name="colorOnSecondaryContainer">@color/on_primary</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorOnSurfaceVariant">@color/on_muted_fg</item>
        <item name="colorOnBackground">@color/on_surface</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="colorOutline">@color/outline</item>
        <item name="colorError">@color/destructive</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- M3 container surfaces: kill every leftover light surface app-wide -->
        <item name="colorSurfaceContainer">@color/background</item>
        <item name="colorSurfaceContainerLow">@color/background</item>
        <item name="colorSurfaceContainerLowest">@color/surface</item>
        <item name="colorSurfaceContainerHigh">@color/surface</item>
        <item name="colorSurfaceContainerHighest">@color/surface</item>
    </style>

    <!-- Small glowing tech pill used on the About screen -->
    <style name="TechPill">
        <item name="android:background">@drawable/bg_date_pill</item>
        <item name="android:layout_marginEnd">6dp</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:textColor">@color/on_muted_fg</item>
        <item name="android:textSize">11sp</item>
    </style>

    <!-- Dark glowing theme for the Material date-picker calendar -->
    <style name="GlowCalendar" parent="ThemeOverlay.Material3.MaterialCalendar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">@color/surface_variant</item>
        <item name="colorOnPrimaryContainer">@color/on_surface</item>
        <item name="colorSecondaryContainer">@color/primary</item>
        <item name="colorOnSecondaryContainer">@color/on_primary</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorOnSurfaceVariant">@color/on_muted_fg</item>
        <item name="colorOutline">@color/outline</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="android:windowBackground">@color/background</item>

        <!-- M3 container surfaces used by the dialog/bottom-sheet calendar -->
        <item name="colorSurfaceContainer">@color/background</item>
        <item name="colorSurfaceContainerLow">@color/background</item>
        <item name="colorSurfaceContainerLowest">@color/surface</item>
        <item name="colorSurfaceContainerHigh">@color/surface</item>
        <item name="colorSurfaceContainerHighest">@color/surface</item>

        <!-- Hard fallbacks so text can never blend again -->
        <item name="android:textColorPrimary">@color/on_surface</item>
        <item name="android:textColorSecondary">@color/on_muted_fg</item>

        <item name="materialCalendarFullscreenTheme">@style/GlowCalendar.Fullscreen</item>
    </style>

    <!-- Full-screen variant: kills every light surface the calendar owns -->
    <style name="GlowCalendar.Fullscreen" parent="ThemeOverlay.Material3.MaterialCalendar">
        <item name="android:colorBackground">@color/background</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="materialCalendarStyle">@style/GlowMaterialCalendar</item>
    </style>

    <style name="GlowMaterialCalendar" parent="Widget.Material3.MaterialCalendar">
        <item name="android:background">@color/background</item>
        <item name="android:textColorPrimary">@color/on_surface</item>
        <item name="android:textColorSecondary">@color/on_muted_fg</item>
    </style>
</resources>
