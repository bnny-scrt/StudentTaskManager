<?xml version="1.0" encoding="utf-8"?>
<!-- White filled button with a layered glow halo -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#40FFFFFF">
    <item>
        <layer-list>
            <!-- Outermost faint halo -->
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="18dp" />
                    <stroke android:width="7dp" android:color="#1AFFFFFF" />
                </shape>
            </item>
            <!-- Mid glow ring -->
            <item
                android:left="5dp"
                android:top="5dp"
                android:right="5dp"
                android:bottom="5dp">
                <shape android:shape="rectangle">
                    <corners android:radius="13dp" />
                    <stroke android:width="3dp" android:color="#40FFFFFF" />
                </shape>
            </item>
            <!-- White button face -->
            <item
                android:left="8dp"
                android:top="8dp"
                android:right="8dp"
                android:bottom="8dp">
                <shape android:shape="rectangle">
                    <corners android:radius="10dp" />
                    <solid android:color="#FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
