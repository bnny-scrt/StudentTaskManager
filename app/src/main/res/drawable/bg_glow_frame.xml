<?xml version="1.0" encoding="utf-8"?>
<!-- Black background with a neon glow only along the screen edges -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Black canvas -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/background" />
        </shape>
    </item>
    <!-- Faint outer halo hugging the edges -->
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="6dp" android:color="#14FFFFFF" />
        </shape>
    </item>
    <!-- Brighter inner ring close to the edge -->
    <item
        android:left="4dp"
        android:top="4dp"
        android:right="4dp"
        android:bottom="4dp">
        <shape android:shape="rectangle">
            <stroke android:width="2dp" android:color="#3DFFFFFF" />
        </shape>
    </item>
</layer-list>
